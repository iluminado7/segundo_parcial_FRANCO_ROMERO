<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<GridPane hgap="10" vgap="10" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="controllers.VentasController">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <Label text="Productos" GridPane.columnIndex="0" GridPane.rowIndex="0" />

    <TableView fx:id="tablaProductos" prefHeight="230" prefWidth="330" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.rowSpan="3">
        <columns>
            <TableColumn fx:id="colNombre" prefWidth="150" text="Nombre" />
            <TableColumn fx:id="colPrecio" prefWidth="90" text="Precio" />
            <TableColumn fx:id="colStock" prefWidth="80" text="Stock" />
        </columns>
    </TableView>

    
    <Label prefHeight="18.0" prefWidth="88.0" text="Cantidad:" GridPane.columnIndex="1" GridPane.rowIndex="1" />

    <TextField fx:id="txtCantidad" prefWidth="60" GridPane.columnIndex="2" GridPane.rowIndex="1" />

    <Button onAction="#agregar" text="Agregar" GridPane.columnIndex="2" GridPane.rowIndex="2" />

    <Label text="Carrito" GridPane.columnIndex="3" GridPane.rowIndex="0" />

    <ListView fx:id="listaCarrito" prefHeight="230" prefWidth="230" GridPane.columnIndex="3" GridPane.rowIndex="1" GridPane.rowSpan="3" />

    <Button onAction="#confirmarCompra" text="Confirmar compra" GridPane.columnIndex="3" GridPane.rowIndex="4" />

    <Label fx:id="lblMensaje" text="" GridPane.columnIndex="0" GridPane.columnSpan="4" GridPane.rowIndex="5" />
   <columnConstraints>
      <ColumnConstraints />
      <ColumnConstraints />
      <ColumnConstraints />
      <ColumnConstraints />
   </columnConstraints>
   <rowConstraints>
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints />
   </rowConstraints>

</GridPane>
