<?xml version="1.0" encoding="UTF-8"?>



<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>

<GridPane hgap="10" vgap="10"
          xmlns:fx="http://javafx.com/fxml"
          fx:controller="controllers.VentasController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- ===== IZQUIERDA: productos ===== -->
    <Label text="Productos"
           GridPane.columnIndex="0" GridPane.rowIndex="0"/>

    <TableView fx:id="tablaProductos" prefWidth="330" prefHeight="230"
               GridPane.columnIndex="0" GridPane.rowIndex="1"
               GridPane.rowSpan="3">
        <columns>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150"/>
            <TableColumn fx:id="colPrecio" text="Precio" prefWidth="90"/>
            <TableColumn fx:id="colStock" text="Stock" prefWidth="80"/>
        </columns>
    </TableView>

    <!-- ===== CENTRO: cantidad y agregar ===== -->
    <Label text="Cant:"
           GridPane.columnIndex="1" GridPane.rowIndex="1"/>

    <TextField fx:id="txtCantidad" prefWidth="60"
               GridPane.columnIndex="2" GridPane.rowIndex="1"/>

    <Button text="Agregar" onAction="#agregar"
            GridPane.columnIndex="2" GridPane.rowIndex="2"/>

    <!-- ===== DERECHA: carrito =====
         OJO: ListView, NO TableView. Lo pide el enunciado.
         Muestra el toString() de ItemCarrito.               -->
    <Label text="Carrito"
           GridPane.columnIndex="3" GridPane.rowIndex="0"/>

    <ListView fx:id="listaCarrito" prefWidth="230" prefHeight="230"
              GridPane.columnIndex="3" GridPane.rowIndex="1"
              GridPane.rowSpan="3"/>

    <Button text="Confirmar compra" onAction="#confirmarCompra"
            GridPane.columnIndex="3" GridPane.rowIndex="4"/>

    <Label fx:id="lblMensaje" text=""
           GridPane.columnIndex="0" GridPane.rowIndex="5"
           GridPane.columnSpan="4"/>

</GridPane>


